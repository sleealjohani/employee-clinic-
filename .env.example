# ---------------------------------------------------------------- database
# Any PostgreSQL instance. On Vercel the easiest path is Neon (Storage → Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used only by `prisma migrate deploy`.
# With Neon this is the "direct" connection string; elsewhere it can equal DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------- sessions
# Signing key for session cookies. Must be at least 32 characters.
#   openssl rand -base64 48
AUTH_SECRET=""

# One-time token that unlocks /setup so the first administrator can be created.
# Setup closes itself permanently once any user exists. Use a long random value.
SETUP_TOKEN=""

# ---------------------------------------------------------------- assisted import (optional)
# Leave ENABLE_AI_IMPORT unset to run the clinic with manual lab entry only.
# Turning it on sends uploaded lab reports to the Claude API for transcription —
# do not enable it before that data transfer is approved.
ENABLE_AI_IMPORT="false"
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------- seeding (local only)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe2026!"
SEED_DEMO_DATA="true"
