# ---------------------------------------------------------------- database
# Production target: Supabase PostgreSQL + Prisma on Vercel.
#
# DATABASE_URL = Supabase Transaction Pooler (port 6543).
# The Prisma PostgreSQL adapter uses a bounded node-postgres connection pool.
# Replace <project-ref>, <password>, and <region> with values from Supabase → Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# DIRECT_URL = Supabase Session Pooler (port 5432).
# Used by Prisma migrations/DDL during deploy. Do not set this to an empty string.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# This application currently uses Supabase as PostgreSQL storage through Prisma.
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are therefore
# not required by the current codebase. Add them only if a Supabase JS client is
# introduced later.

# ---------------------------------------------------------------- sessions
# Signing key for session cookies. REQUIRED at runtime and must be >= 32 chars.
# Generate a long random secret, for example: openssl rand -base64 48
# Never commit the real value to GitHub.
AUTH_SECRET=""

# One-time token that unlocks /setup so the first administrator can be created.
# Setup closes itself permanently once any user exists. Use a long random value.
# Never commit the real value to GitHub.
SETUP_TOKEN=""

# ---------------------------------------------------------------- assisted import
# Local PDF text extraction works without an external provider. Images/scans can
# be transcribed manually. External assistance requires ALL three settings below
# and approval of the clinic's data-processing arrangements. Human review remains
# mandatory before saving results into a clinical record.
ANTHROPIC_API_KEY=""
ENABLE_AI_IMPORT="false"
LAB_EXTRACTION_MODEL=""

# ---------------------------------------------------------------- seeding (local only)
# These are for explicit local `npm run db:seed` only. Vercel deploy does not
# seed demo data. Do not configure them in production unless you intentionally
# run the seed command.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
